# =============================================================================
# Client Portal Starter — environment variables (sample)
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# `.env*` files are gitignored except this example.
# =============================================================================

# Public app URL (used for absolute links, canonical URLs, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App display name (white-labelling)
NEXT_PUBLIC_APP_NAME="Client Portal"

# ---- The variables below are placeholders for when you add a real backend ----

# Auth / session (server-only). Generate with: openssl rand -base64 32
# SESSION_SECRET=

# Database connection string (server-only)
# DATABASE_URL=

# Object storage for documents (server-only) — e.g. S3 / Azure Blob
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Payments provider (server-only) — e.g. Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Error reporting / analytics (public keys are safe to expose)
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_ANALYTICS_ID=
